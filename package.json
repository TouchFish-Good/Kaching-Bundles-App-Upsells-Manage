{
  "name": "kaching-developer-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --local",
    "bootstrap-owner": "node scripts/bootstrap-owner.mjs",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build",
    "check:worker": "tsc --noEmit -p worker/tsconfig.json",
    "test": "npm run test:worker",
    "test:worker": "vitest run --config worker/vitest.config.ts"
  },
  "dependencies": {
    "hono": "^4.7.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.12",
    "@cloudflare/workers-types": "^4.20250321.0",
    "@types/express": "^4.17.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.7.1"
  }
}
